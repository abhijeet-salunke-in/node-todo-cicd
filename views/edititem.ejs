<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Task - TaskFlow</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: linear-gradient(135deg, #eef2ff, #f8fafc);
            color: #1e293b;
        }

        .edit-container {
            width: 100%;
            max-width: 550px;
        }

        .edit-card {
            background: white;
            padding: 35px;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(15, 23, 42, 0.10);
        }

        .icon {
            width: 55px;
            height: 55px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: #eef2ff;
            color: #4f46e5;
            font-size: 25px;
            margin-bottom: 20px;
        }

        .edit-card h1 {
            font-size: 28px;
            margin-bottom: 8px;
            color: #1e293b;
        }

        .subtitle {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .current-task {
            padding: 14px 16px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            margin-bottom: 20px;
            color: #475569;
            word-break: break-word;
        }

        .current-task strong {
            display: block;
            font-size: 12px;
            color: #64748b;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #334155;
        }

        input[type="text"] {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            outline: none;
            font-size: 15px;
            transition: 0.3s;
            margin-bottom: 18px;
        }

        input[type="text"]:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
        }

        .buttons {
            display: flex;
            gap: 10px;
        }

        .save-btn,
        .back-btn {
            flex: 1;
            padding: 13px 18px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
            transition: 0.25s;
        }

        .save-btn {
            background: #4f46e5;
            color: white;
            border: none;
        }

        .save-btn:hover {
            background: #4338ca;
            transform: translateY(-1px);
        }

        .back-btn {
            background: #f1f5f9;
            color: #334155;
        }

        .back-btn:hover {
            background: #e2e8f0;
        }

        @media (max-width: 500px) {
            .edit-card {
                padding: 25px;
            }

            .buttons {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <div class="edit-container">

        <div class="edit-card">

            <div class="icon">
                ✎
            </div>

            <h1>Edit Task</h1>

            <p class="subtitle">
                Update your task and save the changes.
            </p>

            <div class="current-task">
                <strong>Current task</strong>
                <%= todo %>
            </div>

            <form action="/todo/edit/<%= todoIdx %>" method="post">

                <input
                    type="hidden"
                    name="_method"
                    value="PUT"
                >

                <label for="editTodo">
                    New task
                </label>

                <input
                    type="text"
                    name="editTodo"
                    id="editTodo"
                    placeholder="Enter updated task"
                    value="<%= todo %>"
                    autofocus
                    required
                >

                <div class="buttons">

                    <a
                        href="/todo"
                        class="back-btn"
                    >
                        Cancel
                    </a>

                    <input
                        type="submit"
                        value="Save Changes"
                        class="save-btn"
                    >

                </div>

            </form>

        </div>

    </div>

</body>
</html>
