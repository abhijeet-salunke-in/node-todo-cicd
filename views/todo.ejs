<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TaskFlow - Todo List</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #eef2ff, #f8fafc);
            color: #1e293b;
        }

        .container {
            width: 90%;
            max-width: 850px;
            margin: 50px auto;
        }

        /* Header */
        .header {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: white;
            padding: 35px 30px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(79, 70, 229, 0.25);
            margin-bottom: 25px;
        }

        .header h1 {
            font-size: 34px;
            margin-bottom: 8px;
        }

        .header p {
            font-size: 16px;
            opacity: 0.9;
        }

        /* Add task section */
        .add-task {
            background: white;
            padding: 22px;
            border-radius: 16px;
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.08);
            margin-bottom: 25px;
        }

        .add-task h2 {
            font-size: 20px;
            margin-bottom: 15px;
            color: #334155;
        }

        .task-form {
            display: flex;
            gap: 10px;
        }

        .task-form input[type="text"] {
            flex: 1;
            padding: 14px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            outline: none;
            font-size: 15px;
            transition: 0.3s;
        }

        .task-form input[type="text"]:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
        }

        .task-form input[type="submit"] {
            padding: 14px 22px;
            background: #4f46e5;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }

        .task-form input[type="submit"]:hover {
            background: #4338ca;
            transform: translateY(-1px);
        }

        /* Todo list */
        .todo-section {
            background: white;
            padding: 22px;
            border-radius: 16px;
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.08);
        }

        .todo-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .todo-header h2 {
            font-size: 20px;
            color: #334155;
        }

        .count {
            background: #eef2ff;
            color: #4f46e5;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        ul {
            list-style: none;
        }

        li {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 15px 16px;
            margin-bottom: 12px;
            transition: 0.25s;
        }

        li:hover {
            transform: translateX(3px);
            border-color: #c7d2fe;
            box-shadow: 0 5px 15px rgba(15, 23, 42, 0.06);
        }

        .task-number {
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e0e7ff;
            color: #4f46e5;
            border-radius: 50%;
            font-size: 13px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .task-text {
            flex: 1;
            font-size: 15px;
            color: #334155;
            word-break: break-word;
        }

        .actions {
            display: flex;
            gap: 8px;
        }

        .action-btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            text-decoration: none;
            font-size: 16px;
            transition: 0.25s;
        }

        .edit-btn {
            background: #fef3c7;
            color: #d97706;
        }

        .edit-btn:hover {
            background: #fde68a;
            transform: scale(1.05);
        }

        .delete-btn {
            background: #fee2e2;
            color: #dc2626;
        }

        .delete-btn:hover {
            background: #fecaca;
            transform: scale(1.05);
        }

        /* Empty state */
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #64748b;
        }

        .empty-icon {
            font-size: 42px;
            margin-bottom: 10px;
        }

        .empty-state h3 {
            margin-bottom: 6px;
            color: #334155;
        }

        /* Footer */
        .footer {
            text-align: center;
            margin-top: 25px;
            color: #64748b;
            font-size: 13px;
        }

        /* Responsive */
        @media (max-width: 600px) {
            .container {
                width: 94%;
                margin: 25px auto;
            }

            .header {
                padding: 28px 22px;
            }

            .header h1 {
                font-size: 28px;
            }

            .task-form {
                flex-direction: column;
            }

            .task-form input[type="submit"] {
                width: 100%;
            }

            li {
                align-items: flex-start;
            }

            .actions {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- Header -->
        <div class="header">
            <h1>TaskFlow</h1>
            <p>Organize your tasks. Focus on what matters.</p>
        </div>

        <!-- Add Task -->
        <div class="add-task">
            <h2>Add a New Task</h2>

            <form action="/todo/add/" method="post" class="task-form">
                <input
                    type="text"
                    name="newtodo"
                    id="newtodo"
                    placeholder="What do you need to do?"
                    autofocus
                    required
                />

                <input
                    type="submit"
                    value="Add Task"
                />
            </form>
        </div>

        <!-- Todo List -->
        <div class="todo-section">

            <div class="todo-header">
                <h2>Your Tasks</h2>

                <span class="count">
                    <%= todolist.length %>
                    <%= todolist.length === 1 ? "Task" : "Tasks" %>
                </span>
            </div>

            <% if (todolist.length === 0) { %>

                <div class="empty-state">
                    <div class="empty-icon">📝</div>

                    <h3>No tasks yet</h3>

                    <p>
                        Add your first task and start getting things done.
                    </p>
                </div>

            <% } else { %>

                <ul>
                    <% todolist.forEach(function(todo, index) { %>

                        <li>

                            <div class="task-number">
                                <%= index + 1 %>
                            </div>

                            <div class="task-text">
                                <%= todo %>
                            </div>

                            <div class="actions">

                                <a
                                    href="/todo/<%= index %>"
                                    class="action-btn edit-btn"
                                    title="Edit task"
                                >
                                    ✎
                                </a>

                                <a
                                    href="/todo/delete/<%= index %>"
                                    class="action-btn delete-btn"
                                    title="Delete task"
                                    onclick="return confirm('Are you sure you want to delete this task?');"
                                >
                                    ×
                                </a>

                            </div>

                        </li>

                    <% }); %>
                </ul>

            <% } %>

        </div>

        <div class="footer">
            TaskFlow • Simple task management
        </div>

    </div>

</body>
</html>
